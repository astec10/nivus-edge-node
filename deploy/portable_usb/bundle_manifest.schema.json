{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/astec10/nivus-edge-node/blob/main/deploy/portable_usb/bundle_manifest.schema.json",
  "title": "Nivus installer bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "project",
    "bundle_version",
    "source_commit",
    "profiles",
    "payload_mode",
    "files"
  ],
  "properties": {
    "format_version": { "const": 1 },
    "project": { "const": "nivus" },
    "bundle_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
    },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "profiles": {
      "type": "array",
      "items": { "enum": ["master", "worker"] },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "payload_mode": { "const": "source_snapshot" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._+/-]+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
