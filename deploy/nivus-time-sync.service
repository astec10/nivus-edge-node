[Unit]
Description=Nivus restricted host time synchronization controller
After=network-online.target systemd-timesyncd.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/nivus-compose/time-sync.env
ExecStart=/usr/bin/python3 /opt/nivus-compose/current/deploy/nivus-timesyncd.py
Restart=on-failure
RestartSec=3
RuntimeDirectory=nivus-time-sync
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/systemd/timesyncd.conf.d /var/backups/nivus-compose/time-sync /run/nivus-time-sync
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
